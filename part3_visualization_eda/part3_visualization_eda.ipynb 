        "\n",
        "df = pd.concat(frames, ignore_index=True)\n",
        "cats = pd.read_csv(\"data/categories.csv\")\n",
        "df = df.merge(cats, on=\"category_id\", how=\"left\")\n",
        "\n",
        "df[\"trending_date\"] = pd.to_datetime(df[\"trending_date\"], format=\"%y.%d.%m\")\n",
